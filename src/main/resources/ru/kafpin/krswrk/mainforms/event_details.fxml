<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<TabPane fx:id="detailsTabPane" tabClosingPolicy="UNAVAILABLE" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.kafpin.krswrk.controller.EventDetailsController">

    <Tab closable="false" text="%tab.main">
        <VBox spacing="10" style="-fx-padding: 15 15 0 15;" VBox.vgrow="ALWAYS">
            <GridPane hgap="10" vgap="10" VBox.vgrow="ALWAYS">
                <columnConstraints>
                    <ColumnConstraints hgrow="NEVER" minWidth="120" prefWidth="120" />
                    <ColumnConstraints hgrow="ALWAYS" minWidth="200" />
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="30" vgrow="NEVER" />
                    <RowConstraints minHeight="30" vgrow="NEVER" />
                    <RowConstraints minHeight="30" vgrow="NEVER" />
                    <RowConstraints minHeight="30" vgrow="NEVER" />
                    <RowConstraints minHeight="30" vgrow="NEVER" />
                    <RowConstraints minHeight="30" vgrow="NEVER" />
                    <RowConstraints minHeight="30" vgrow="ALWAYS" />
                    <RowConstraints minHeight="40" vgrow="NEVER" />
                </rowConstraints>
                <children>
                    <Label text="%field.name" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="nameField" editable="false" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="%field.date" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Label fx:id="dateLabel" style="-fx-padding: 5; -fx-background-color: #f9f9f9; -fx-border-color: #ccc; -fx-border-radius: 3;" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="%field.budget" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="budgetField" editable="false" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="%field.status" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="statusField" editable="false" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="%field.client" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="clientField" editable="false" maxWidth="Infinity" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                    <Label text="%field.venue" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <TextField fx:id="venueField" editable="false" maxWidth="Infinity" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                    <Label text="%field.feedback" GridPane.rowIndex="6" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
                    <TextArea fx:id="feedbackArea" editable="false" maxHeight="Infinity" maxWidth="Infinity" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                    <HBox spacing="10" GridPane.rowIndex="7" GridPane.columnIndex="1" GridPane.halignment="RIGHT">
                        <Button onAction="#onEditEvent" text="%button.editEvent"/>
                        <Button onAction="#onDeleteEvent" style="-fx-background-color: #d9534f; -fx-text-fill: white;" text="%button.deleteEvent"/>
                    </HBox>
                </children>
            </GridPane>
        </VBox>
    </Tab>

    <Tab text="%tab.budget">
        <VBox spacing="10" style="-fx-padding: 15;" VBox.vgrow="ALWAYS">
            <HBox spacing="20">
                <Label text="%budget.planned" />
                <Label fx:id="budgetLabel" style="-fx-font-weight: bold;" />
                <Label text="%budget.actual" />
                <Label fx:id="expensesSumLabel" style="-fx-text-fill: red;" />
                <Label text="%budget.remaining" />
                <Label fx:id="remainingLabel" style="-fx-text-fill: green;" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="%expense.filter" />
                <ComboBox fx:id="expenseCategoryFilterCombo" promptText="%filter.all" />
                <Label text="%expense.search"/>
                <TextField fx:id="expenseSearchField" promptText="%expense.search.placeholder" HBox.hgrow="ALWAYS"/>
            </HBox>
            <TableView fx:id="expenseTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="expenseDateCol" prefWidth="100" text="%expense.date" />
                    <TableColumn fx:id="amountCol" prefWidth="100" text="%expense.amount" />
                    <TableColumn fx:id="categoryCol" prefWidth="150" text="%expense.category" />
                    <TableColumn fx:id="contractorCol" prefWidth="150" text="%expense.contractor" />
                    <TableColumn fx:id="descCol" prefWidth="250" text="%expense.description" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
            <HBox spacing="10">
                <Button onAction="#onAddExpense" text="%button.addExpense" />
                <Button onAction="#onEditExpense" text="%button.editExpense" />
                <Button onAction="#onDeleteExpense" style="-fx-background-color: #d9534f; -fx-text-fill: white;" text="%button.deleteExpense" />
            </HBox>
        </VBox>
    </Tab>

    <Tab text="%tab.tasks">
        <VBox spacing="10" style="-fx-padding: 15;" VBox.vgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="%task.filter" />
                <ComboBox fx:id="statusFilterCombo" promptText="%filter.all" />
                <Label text="%task.search" />
                <TextField fx:id="taskSearchField" promptText="%task.search.placeholder" HBox.hgrow="ALWAYS" />
            </HBox>
            <TableView fx:id="taskTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="taskDescCol" prefWidth="200" text="%task.description" />
                    <TableColumn fx:id="deadlineCol" prefWidth="100" text="%task.deadline" />
                    <TableColumn fx:id="taskStatusCol" prefWidth="100" text="%task.status" />
                    <TableColumn fx:id="responsibleCol" prefWidth="150" text="%task.contractor" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button onAction="#onAddTask" text="%button.addTask" />
                <Button onAction="#onEditTask" text="%button.editTask" />
                <Button onAction="#onDeleteTask" style="-fx-background-color: #d9534f; -fx-text-fill: white;" text="%button.deleteTask" />
            </HBox>
        </VBox>
    </Tab>

    <Tab text="%tab.contractors">
        <VBox spacing="10" style="-fx-padding: 15;" VBox.vgrow="ALWAYS">
            <HBox spacing="15" VBox.vgrow="ALWAYS">
                <VBox spacing="5" prefWidth="250">
                    <Label style="-fx-font-weight: bold;" text="%contractor.list"/>
                    <HBox alignment="CENTER_LEFT" minWidth="200" spacing="10">
                        <Label text="%contractor.filter"/>
                        <ComboBox fx:id="contractorTypeFilterCombo" promptText="%filter.all"/>
                    </HBox>
                    <TableView fx:id="contractorTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="contractorNameCol" prefWidth="150" minWidth="100" text="%contractor.name"/>
                            <TableColumn fx:id="contractorServiceCol" prefWidth="100" minWidth="70" text="%contractor.serviceType"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>

                <VBox spacing="10" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                    <Label style="-fx-font-weight: bold;" text="%contractor.details"/>
                    <Label fx:id="detailName" wrapText="true"/>
                    <Label fx:id="detailContactPerson" wrapText="true"/>
                    <Label fx:id="detailPhone" wrapText="true"/>
                    <Label fx:id="detailEmail" wrapText="true"/>
                    <Label fx:id="detailServiceType" wrapText="true"/>

                    <Label style="-fx-font-weight: bold;" text="%contractor.priceList"/>
                    <TextArea fx:id="detailPriceList" editable="false" prefHeight="100" wrapText="true" VBox.vgrow="ALWAYS"/>

                    <Label style="-fx-font-weight: bold;" text="%contractor.notes"/>
                    <TextArea fx:id="detailNotes" editable="false" prefHeight="80" wrapText="true" VBox.vgrow="ALWAYS"/>
                    <HBox spacing="10">
                        <Button onAction="#onCreateExpenseForContractor" text="%button.createExpense"/>
                        <Button onAction="#onCreateTaskForContractor" text="%button.createTask"/>
                        <Button onAction="#onAddContractor" text="%button.addContractor"/>
                        <Button onAction="#onEditContractor" text="%button.editContractor" />
                        <Button onAction="#onDeleteContractor" style="-fx-background-color: #d9534f; -fx-text-fill: white;" text="%button.deleteContractor"/>
                    </HBox>
                </VBox>
            </HBox>
        </VBox>
    </Tab>

    <Tab text="%tab.guests">
        <VBox spacing="10" style="-fx-padding: 15;" VBox.vgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="%guest.filter" />
                <ComboBox fx:id="guestStatusFilterCombo" promptText="%filter.all" />
            </HBox>
            <TableView fx:id="guestTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="guestNameCol" prefWidth="200" text="%guest.fullName" />
                    <TableColumn fx:id="guestPhoneCol" prefWidth="120" text="%guest.phone" />
                    <TableColumn fx:id="guestEmailCol" prefWidth="150" text="%guest.email" />
                    <TableColumn fx:id="guestStatusCol" prefWidth="100" text="%guest.status" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button onAction="#onAddGuest" text="%button.addGuest" />
                <Button onAction="#onEditGuest" text="%button.editGuest" />
                <Button onAction="#onDeleteGuest" style="-fx-background-color: #d9534f; -fx-text-fill: white;" text="%button.deleteGuest" />
            </HBox>
        </VBox>
    </Tab>

    <Tab text="%tab.report">
        <VBox spacing="10" style="-fx-padding: 15;" VBox.vgrow="ALWAYS">
            <HBox spacing="10">
                <Button onAction="#onGenerateReport" text="%button.generateReport" />
                <Button onAction="#onExportReportToFile" text="%button.exportReport" />
            </HBox>
            <TextArea fx:id="reportArea" editable="false" VBox.vgrow="ALWAYS" />
            <HBox spacing="10">
                <Label text="%field.clientFeedback" />
                <TextField fx:id="clientFeedbackField" HBox.hgrow="ALWAYS" />
                <Button onAction="#onSaveFeedback" text="%button.saveFeedback" />
            </HBox>
        </VBox>
    </Tab>
</TabPane>
