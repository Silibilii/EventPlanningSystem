<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.ComboBox?>
<BorderPane fx:id="mainPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.kafpin.krswrk.controller.MainController">
    <top>
        <MenuBar>
            <Menu text="%menu.file">
                <MenuItem text="%menu.file.exit" onAction="#exitApplication" />
            </Menu>
            <Menu text="%menu.view">
                <MenuItem text="%menu.view.hideLeft" onAction="#toggleLeftPanel" />
            </Menu>
            <Menu fx:id="menuAdd" text="%menu.add">
                <MenuItem fx:id="menuAddClient" text="%menu.add.client" onAction="#onNewClient" />
                <MenuItem fx:id="menuAddVenue" text="%menu.add.venue" onAction="#onNewVenue" />
                <MenuItem fx:id="menuAddEvent" text="%menu.add.event" onAction="#onNewEvent" />
                <MenuItem fx:id="menuAddContractor" text="%menu.add.contractor" onAction="#onNewContractor" />
            </Menu>
        </MenuBar>
    </top>
    <left>
        <VBox fx:id="leftPanel" spacing="10" style="-fx-padding: 10; -fx-background-color: #f0f0f0;">

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="%language.select" />
                <ComboBox fx:id="languageCombo" maxWidth="Infinity" />

            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="%left.events" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Label text="%event.filter.status"/>
                <ComboBox fx:id="eventStatusFilterCombo" promptText="%filter.all"/>

            </HBox>
            <TableView fx:id="eventTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="nameColumn" text="%column.name" prefWidth="200" />
                    <TableColumn fx:id="dateColumn" text="%column.date" prefWidth="70" />
                    <TableColumn fx:id="statusColumn" text="%column.status" prefWidth="90" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
            <Button text="%button.refreshList" onAction="#onRefreshEvents" maxWidth="Infinity"/>
        </VBox>
    </left>
    <right>
        <AnchorPane fx:id="rightPanel" prefWidth="450" visible="false" managed="false"
                    style="-fx-background-color: #f5f5f5; -fx-border-color: #ccc; -fx-border-width: 0 0 0 1;">
            <VBox fx:id="rightFormContainer" spacing="10" AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0"
                  AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" style="-fx-padding: 15;">
            </VBox>
        </AnchorPane>
    </right>
    <center>
        <fx:include fx:id="eventDetails" source="event_details.fxml"/>
    </center>
</BorderPane>